# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any_random_secret_string
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=info@yourdomain.com

# Anthropic (AI ID Scanning)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# Database (Direct Postgres connection)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Cron (protects /api/cron/* endpoints)
CRON_SECRET=your_random_cron_secret

# Bank e-mandates (direct debit). Leave BANK_MUSCAT_* unset to use the mock
# bank; set E_MANDATE_PROVIDER=mock|bank_muscat to force one.
E_MANDATE_PROVIDER=
BANK_MUSCAT_API_BASE_URL=https://sandbox.example.bankmuscat.com
BANK_MUSCAT_CLIENT_ID=
BANK_MUSCAT_CLIENT_SECRET=
BANK_MUSCAT_CREDITOR_ID=
BANK_MUSCAT_CREDITOR_ACCOUNT=
BANK_MUSCAT_WEBHOOK_SECRET=
# Mock bank knobs (testing only)
E_MANDATE_MOCK_OTP=123456
E_MANDATE_MOCK_COLLECT_RESULT=settled
E_MANDATE_MOCK_WEBHOOK_SECRET=
